# Copy to .env (gitignored) to bake defaults into the SPA bundle at
# `npm run build` / scripts/build-spa.sh time. Rebuild dist after changes.
#
# Embedded server base for the login form and same-origin default: leave
# empty for same-origin serving (opencoder-server --web embeds the SPA).
# Visitors can still override it in the login modal, and links carrying
# #token= / ?token= (+base=) log in without the modal (see urlCredential.js).
# Equivalent one-shot: scripts/build-spa.sh --base https://fleet.example.com
# or SPA_BASE=https://... bash scripts/build-spa.sh (both override .env for
# that build only).
VITE_OC_BASE=
