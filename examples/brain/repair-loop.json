{
  "schema_version": 2,
  "title": "修复与复测",
  "objective": "根据问题修复，复测不通过则再次修复，凭证据交付",
  "inputs": {
    "document": {
      "description": "需求文档",
      "source": {
        "kind": "external"
      },
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "markdown"
        ]
      },
      "required": true
    },
    "feedback": {
      "description": "本轮复测问题",
      "source": {
        "kind": "routed"
      },
      "schema": {
        "type": "string"
      },
      "required": false
    },
    "change": {
      "description": "本轮修复内容",
      "source": {
        "kind": "routed"
      },
      "schema": {
        "type": "string"
      },
      "required": true
    }
  },
  "instances": [
    {
      "id": "fix",
      "description": "根据需求和反馈修复问题",
      "capability_id": "builtin-agent-act",
      "action": {
        "kind": "agent",
        "target": "act",
        "prompt": "根据需求和反馈修复问题",
        "output_mode": "json"
      },
      "inputs": [
        "document",
        "feedback"
      ],
      "outputs": [
        "fix-result"
      ],
      "max_visits": 20,
      "resources": []
    },
    {
      "id": "verify",
      "description": "复测本轮修复，给出问题或通过结论及证据",
      "capability_id": "builtin-agent-act",
      "action": {
        "kind": "agent",
        "target": "act",
        "prompt": "复测本轮修复，给出问题或通过结论及证据",
        "output_mode": "json"
      },
      "inputs": [
        "change"
      ],
      "outputs": [
        "verification"
      ],
      "max_visits": 20,
      "resources": []
    }
  ],
  "outputs": {
    "fix-result": {
      "description": "本轮修复内容与证据"
    },
    "verification": {
      "description": "本轮复测结论、剩余问题与验证依据"
    }
  },
  "entry": [
    "fix"
  ],
  "routes": [
    {
      "id": "after-fix",
      "description": "将本轮修复交给复测",
      "outputs": [
        "fix-result"
      ],
      "targets": [
        {
          "instance": "verify",
          "bindings": {
            "change": "fix-result"
          }
        }
      ],
      "exits": []
    },
    {
      "id": "after-verify",
      "description": "复测仍有问题时携带本轮问题回到修复；验证通过并有证据时交付；结论不明确则阻塞",
      "outputs": [
        "verification"
      ],
      "targets": [
        {
          "instance": "fix",
          "bindings": {
            "feedback": "verification"
          }
        }
      ],
      "exits": [
        {
          "id": "done",
          "description": "交付已完成且复测通过的修复",
          "deliverables": [
            "verification"
          ],
          "require_completed": true,
          "require_verified": true
        }
      ]
    }
  ]
}
