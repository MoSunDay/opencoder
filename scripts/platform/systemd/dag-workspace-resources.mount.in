[Unit]
Description=OpenCoder read-only DAG source workspace
Wants=network-online.target opencoder-resources.service
After=network-online.target opencoder-resources.service
Before=opencoder-agent.service

[Mount]
What=127.0.0.1:/
Where=/mnt/opencoder-dag-workspace
Type=nfs
Options=ro,vers=3,tcp,port=2051,mountport=2051,nolock,soft,retrans=1,timeo=50,actimeo=0,lookupcache=none
TimeoutSec=30

[Install]
WantedBy=multi-user.target
